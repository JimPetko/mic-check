<Window x:Class="MicCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MicCheck.Controls"
        Title="Mic Check" Width="1300" Height="860" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,20,10,20">

                <!-- Device -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Microphone" Style="{StaticResource Caption}" Margin="0,0,12,0" />
                        <ComboBox x:Name="DeviceCombo" Grid.Column="1" SelectionChanged="OnDeviceChanged" />
                        <Button Grid.Column="2" Content="Refresh" Margin="8,0,0,0" Click="OnRefreshClick"
                                ToolTip="Re-scan for microphones" />

                        <TextBlock Grid.Row="1" Text="Input volume" Style="{StaticResource Caption}" Margin="0,12,12,0" />
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                    ValueChanged="OnVolumeSliderChanged" ToolTip="Windows recording level for this device" />
                            <TextBlock x:Name="VolumeText" Grid.Column="1" Text="—" TextAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <CheckBox x:Name="MuteCheck" Grid.Row="1" Grid.Column="2" Content="Muted" Margin="12,12,0,0"
                                  Click="OnMuteClick" />

                        <CheckBox x:Name="NoiseSuppressionCheck" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0"
                                  IsChecked="True" Click="OnNoiseSuppressionClick"
                                  Content="Filter background noise (Windows voice processing)"
                                  ToolTip="Asks Windows to treat this as a voice call so it applies Voice Clarity / driver noise suppression. Removes keyboard and mouse clicks and other background noise. Turn off to hear the raw mic." />

                        <TextBlock x:Name="FormatText" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0"
                                   Style="{StaticResource Caption}" Text="No device" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- Live level -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Live level" Style="{StaticResource SectionTitle}" Margin="0" />
                            <Border x:Name="ClipBadge" HorizontalAlignment="Right" CornerRadius="4" Padding="8,2"
                                    Background="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Hidden">
                                <TextBlock Text="CLIPPING" Foreground="White" FontWeight="Bold" FontSize="11" />
                            </Border>
                        </Grid>

                        <controls:LevelMeter x:Name="Meter"
                                             TrackBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RMS (loudness)" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="RmsText" Text="—" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Peak" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="PeakText" Text="—" FontSize="22" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Status" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="StatusText" Text="—" FontSize="16" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="StatusHint" Margin="0,8,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- History -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Last 10 seconds" Style="{StaticResource SectionTitle}" />
                        <controls:LevelHistory x:Name="History" Height="120"
                                               Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                               GridBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Record and playback -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Record &amp; play back" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Record a 5 second clip, then listen to how you actually sound. Use headphones to avoid feedback." />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RecordButton" Content="Record 5 s" Width="120" Click="OnRecordClick"
                                    Style="{DynamicResource AccentButtonStyle}" />
                            <Button x:Name="PlayButton" Content="Play back" Width="120" Margin="8,0,0,0"
                                    IsEnabled="False" Click="OnPlayClick" />
                            <ProgressBar x:Name="RecordProgress" Width="200" Height="6" Margin="16,0,0,0"
                                         Maximum="1" VerticalAlignment="Center" />
                            <TextBlock x:Name="RecordStatus" Margin="12,0,0,0" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <controls:VoiceEffectsPanel x:Name="EffectsPanel" Margin="10,20,20,20" />
        </ScrollViewer>
    </Grid>
</Window>
